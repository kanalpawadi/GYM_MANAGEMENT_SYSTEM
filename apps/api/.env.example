NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RESEND_API_KEY=re_your_resend_api_key
CRON_SECRET=your_cron_execution_secret_key
ALLOWED_ORIGIN=http://localhost:5173
# Health assistant (Grok by xAI). Keep the key secret: only on the server.
XAI_API_KEY=xai-your-grok-api-key
# Optional: Grok model name (default grok-3-mini)
XAI_MODEL=grok-3-mini
# Using Groq (keys start with gsk_) instead of Grok? Use these two lines:
# XAI_BASE_URL=https://api.groq.com/openai/v1
# XAI_MODEL=llama-3.3-70b-versatile
